# Python / uv
.venv/
training/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# editor / local tooling
.claude/
.vscode/
.idea/

/models/

# models and generated weights — never vendored, see modelspec.py
*.gguf
*.onnx
!tests/audio/fixtures/*.onnx

# raw voice recordings — biometric, never leaves the machine
data/voice/**/*.wav
data/voice/**/*.flac

# avatar binaries (fetched by `elizabeth fetch-models`, see ASSETS.md)
web/public/avatar/

# web build
web/node_modules/
web/dist/

# local state / logs
/tmp/elizabeth-*.wav
*.log

# training datasets — large, and other people's voices; the manifest (data/datasets.toml) is what's committed
data/datasets/
